<Window x:Class="StructuralOffice.Desktop.DunningScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahnung terminieren" Width="460" Height="265"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F7FB">
    <Border Style="{StaticResource CardStyle}" Margin="22" Padding="24">
        <StackPanel>
            <TextBlock Text="Wann soll gemahnt werden?" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Wähle das Zahlungsziel, das du in der Zahlungserinnerung angegeben hast."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
            <DatePicker x:Name="DueDatePicker" SelectedDateFormat="Long" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Cancel_OnClick" />
                <Button Content="Mahnung einplanen" Click="Schedule_OnClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
