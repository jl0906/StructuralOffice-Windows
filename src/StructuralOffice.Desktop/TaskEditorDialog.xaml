<Window x:Class="StructuralOffice.Desktop.TaskEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufgabe" Width="820" Height="780" MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Border Margin="18" Background="#F8FAFD" CornerRadius="18" BorderBrush="#D9E3F0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.23" Color="#172033" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="18,18,0,0"
                    BorderBrush="#E4EAF3" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="26,0,18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText" Text="Aufgabe bearbeiten" FontSize="22"
                                   FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock x:Name="DialogSubtitleText" Text="Details und Planung an einem Ort"
                                   Margin="0,4,0,0" Foreground="#64748B" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="38" Height="38" Padding="0"
                            Background="#EEF2F7" Foreground="#475569" FontSize="20"
                            Click="CancelButton_OnClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28">
                    <Border x:Name="GeneratedTaskNotice" Background="#EFF6FF" BorderBrush="#BFDBFE"
                            BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <TextBlock x:Name="GeneratedTaskNoticeText" Foreground="#1E40AF"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Aufgabe" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="TitleBox" Margin="0,0,0,16" />

                    <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="84"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.75*" /><ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Fällig am" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <DatePicker x:Name="DueDatePicker" SelectedDateFormat="Long" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Uhrzeit" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox x:Name="DueTimeBox" IsEditable="True" Text="09:00">
                                <ComboBoxItem Content="08:00" /><ComboBoxItem Content="09:00" />
                                <ComboBoxItem Content="10:00" /><ComboBoxItem Content="12:00" />
                                <ComboBoxItem Content="14:00" /><ComboBoxItem Content="16:00" />
                                <ComboBoxItem Content="18:00" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Aufwand (Min.)" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBox x:Name="EstimatedMinutesBox" Text="15" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="12" />
                            <ColumnDefinition /><ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Priorität" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox x:Name="PriorityBox" SelectedIndex="1">
                                <ComboBoxItem Content="Niedrig" Tag="low" />
                                <ComboBoxItem Content="Normal" Tag="normal" />
                                <ComboBoxItem Content="Hoch" Tag="high" />
                                <ComboBoxItem Content="Kritisch" Tag="critical" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox x:Name="StatusBox" SelectedIndex="0">
                                <ComboBoxItem Content="Offen" Tag="open" />
                                <ComboBoxItem Content="In Bearbeitung" Tag="in_progress" />
                                <ComboBoxItem Content="Erledigt" Tag="completed" />
                                <ComboBoxItem Content="Übersprungen" Tag="skipped" />
                                <ComboBoxItem Content="Abgebrochen" Tag="cancelled" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Kategorie" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBox x:Name="CategoryBox" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Abschlussnotiz" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="CompletionNoteBox" AcceptsReturn="True" Height="64"
                             TextWrapping="Wrap" Margin="0,0,0,20" />

                    <DockPanel Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="Checkliste" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Teile die Aufgabe in nachvollziehbare Schritte."
                                       Foreground="#64748B" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="ChecklistButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ Schritt" Padding="12,7" Click="AddChecklistButton_OnClick"
                                    Margin="0,0,8,0" />
                            <Button Content="Entfernen" Padding="12,7" Background="#E8EEF7"
                                    Foreground="#29415F" Click="RemoveChecklistButton_OnClick" />
                        </StackPanel>
                    </DockPanel>
                    <Border Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="10">
                        <DataGrid x:Name="ChecklistGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MinHeight="150" MaxHeight="250" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Erledigt" Binding="{Binding Completed}" Width="75" />
                                <DataGridTextColumn x:Name="ChecklistTitleColumn" Header="Schritt"
                                                    Binding="{Binding Title}" Width="1.5*" />
                                <DataGridCheckBoxColumn x:Name="ChecklistRequiredColumn" Header="Pflicht"
                                                        Binding="{Binding Required}" Width="65" />
                                <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" CornerRadius="0,0,18,18"
                    BorderBrush="#E4EAF3" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="24,0">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_OnClick" Margin="0,0,10,0" />
                    <Button x:Name="SaveButton" Content="Aufgabe speichern" Click="SaveButton_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
