<Window x:Class="StructuralOffice.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructuralOffice" Icon="Assets/StructuralOffice.ico"
        Width="1240" Height="800" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid>
        <!-- First-run and signed-out experience -->
        <Grid x:Name="ConnectionView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="34,36">
                    <StackPanel DockPanel.Dock="Top">
                        <Image Source="Assets/icon.png" Width="62" Height="62"
                               HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <TextBlock Text="StructuralOffice" FontSize="23" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Structured office processes at a glance"
                                   Foreground="#8894A8" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Secure sign-in through Home Assistant"
                                   Foreground="#657086" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="Version 1.0.0" Foreground="#94A3B8"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="68,54" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Connect to Home Assistant" FontSize="31"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,9,0,32" Foreground="#98A4B8" FontSize="14"
                               TextWrapping="Wrap"
                               Text="Sign in securely through Home Assistant. Your password and two-factor code are processed exclusively by Home Assistant." />

                    <Border Style="{StaticResource CardStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Home Assistant address" Margin="0,0,0,8" />
                            <TextBox x:Name="ServerUrlBox" Text="http://homeassistant.local:8123"
                                     ToolTip="For example http://homeassistant.local:8123" />
                            <CheckBox x:Name="RememberLoginBox" Margin="0,20,0,7"
                                      Foreground="#E8EDF7" IsChecked="True"
                                      Content="Stay signed in" />
                            <TextBlock Margin="24,0,0,24" Foreground="#748097" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="The refresh token is protected in Windows Credential Manager. Your password is never stored." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoginButton" Content="Sign in with Home Assistant"
                                        Click="LoginButton_OnClick" />
                                <TextBlock x:Name="ProgressText" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Foreground="#98A4B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultPanel" Margin="0,22,0,0" Padding="22"
                            Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Connection status" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,0,0,14" />
                            <ItemsControl x:Name="ResultItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                     VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       Foreground="#AAB4C6" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CheckedAtText" Foreground="#657086"
                                       FontSize="11" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Authenticated application shell -->
        <Grid x:Name="WorkspaceView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="20,24">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="7,0,0,23">
                            <Image Source="Assets/icon.png" Width="38" Height="38" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StructuralOffice" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="1.0.0" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="ARBEITSBEREICH" Foreground="#94A3B8" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,0,0,6" />
                        <StackPanel x:Name="NavigationPanel">
                            <Button Content="Heute" Tag="overview" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Aufgaben" Tag="tasks" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Routinen" Tag="routines" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Rechnungen importieren" Tag="invoices" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                        </StackPanel>

                        <TextBlock Text="SYSTEM" Foreground="#94A3B8" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,22,0,6" />
                        <Button x:Name="SettingsNavigationButton" Content="Settings" Tag="settings"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavigationButton_OnClick" />
                        <Button x:Name="AdministrationNavigationButton" Content="Administration" Tag="administration"
                                Style="{StaticResource NavButtonStyle}" Visibility="Collapsed"
                                Click="NavigationButton_OnClick" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#171C26" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8"
                                             Fill="#3FC784" Margin="0,0,8,0" />
                                    <TextBlock Text="Verbunden" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                                <TextBlock x:Name="SidebarServerText" Foreground="#748097"
                                           FontSize="10" Margin="16,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="LogoutButton" Content="Sign out"
                                Style="{StaticResource NavButtonStyle}"
                                Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Background="White">
                    <Grid Margin="38,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="Overview" FontSize="23"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PageSubtitleText"
                                       Text="Your StructuralOffice workspace"
                                       Foreground="#7F8BA0" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,48">
                            <Border CornerRadius="14" Padding="28" Margin="0,0,0,22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2563EB" Offset="0" />
                                        <GradientStop Color="#1D4ED8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Dein heutiger Bürotag" FontSize="17"
                                                   Foreground="#DBEAFE" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TodayMinutesText" Text="–" FontSize="38"
                                                   Foreground="White" FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock x:Name="TodayTaskCountText" Text="Aufgaben werden geladen"
                                                   Foreground="#DBEAFE" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="16"
                                            Padding="13,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DashboardStatusDot" Width="8" Height="8"
                                                     Fill="#6FE1A8" Margin="0,0,8,0" />
                                            <TextBlock x:Name="DashboardStatusText" Text="Bereit" Foreground="White"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Längste anstehende Aufgabe" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,26" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="LongestTaskTitleText" Text="Keine Aufgabe fällig"
                                                   FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LongestTaskMetaText" Text="Dein Tag ist frei geplant."
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Aufgaben öffnen" Tag="tasks" Margin="20,0,0,0"
                                            VerticalAlignment="Center" Click="NavigationButton_OnClick" />
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Deine Aufgaben" FontSize="18" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="Alle Aufgaben" Tag="tasks" Padding="13,7"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                            </Grid>
                            <TextBlock Text="Heute und überfällige Aufgaben in zeitlicher Reihenfolge"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" />
                            <TextBlock x:Name="TodayTasksEmptyText" Text="Für heute ist nichts mehr offen."
                                       Visibility="Collapsed" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="14" Margin="0,14,0,0" />
                            <ListBox x:Name="TodayTasksList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="TodayTasksList_OnSelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,9" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsEnabled="{Binding CanComplete}"
                                                          ToolTip="Als erledigt markieren"
                                                          PreviewMouseLeftButtonDown="TodayTaskCompletionCheckBox_OnPreviewMouseLeftButtonDown"
                                                          Click="TodayTaskCompletionCheckBox_OnClick" />
                                                <StackPanel Grid.Column="1" Margin="18,15" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DayLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding Accent}" />
                                                <StackPanel Grid.Column="3" Margin="20,14" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="4" Background="#EFF6FF" CornerRadius="12" Padding="11,6"
                                                        Margin="12" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Duration}" Foreground="#1D4ED8" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DashboardServerText" Visibility="Collapsed" />
                            <TextBlock x:Name="IntegrationVersionText" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModulePanel" Visibility="Collapsed" Margin="30,24,30,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ModuleToolbarPanel" Grid.Row="0" Style="{StaticResource CardStyle}"
                                Padding="16,12" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="RefreshModuleButton" Content="Aktualisieren"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshModuleButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="NewRecordButton" Content="Neu"
                                            Click="NewRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="SaveRecordButton" Content="Speichern"
                                            Click="SaveRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="ArchiveRecordButton" Content="Archivieren"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ArchiveRecordButton_OnClick" Margin="0,0,8,0" />
                                </WrapPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBox x:Name="ModuleSearchBox" Width="190" Padding="9,6"
                                             ToolTip="Search records"
                                             TextChanged="ModuleSearchBox_OnTextChanged" />
                                    <CheckBox x:Name="IncludeArchivedBox" Content="Archived"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Foreground="{StaticResource TextBrush}"
                                              Checked="IncludeArchivedBox_OnChanged"
                                              Unchecked="IncludeArchivedBox_OnChanged" />
                                </StackPanel>
                                <TextBlock x:Name="ModuleBusyText" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="#91A1B8" />
                            </DockPanel>
                        </Border>

                        <Border x:Name="ContextActionsPanel" Grid.Row="1"
                                Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <WrapPanel>
                                <ComboBox x:Name="TaskStatusFilterBox" Width="165" Margin="0,0,8,0"
                                          SelectionChanged="TaskFilterBox_OnChanged" SelectedIndex="1">
                                    <ComboBoxItem Content="Alle Status" Tag="" />
                                    <ComboBoxItem Content="Offen" Tag="open" />
                                    <ComboBoxItem Content="In Bearbeitung" Tag="in_progress" />
                                    <ComboBoxItem Content="Erledigt" Tag="completed" />
                                    <ComboBoxItem Content="Übersprungen" Tag="skipped" />
                                    <ComboBoxItem Content="Abgebrochen" Tag="cancelled" />
                                </ComboBox>
                                <ComboBox x:Name="TaskSourceFilterBox" Width="155" Margin="0,0,8,0"
                                          SelectionChanged="TaskFilterBox_OnChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Alle Quellen" Tag="" />
                                    <ComboBoxItem Content="Routinen" Tag="routine" />
                                    <ComboBoxItem Content="Manuell" Tag="manual" />
                                    <ComboBoxItem Content="Zahlung &amp; Mahnung" Tag="accounting_due_batch" />
                                </ComboBox>
                                <Button x:Name="NewTaskButton" Content="Neue Aufgabe"
                                        Click="NewTaskButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportInvoicesButton" Content="Import CSV"
                                        Click="ImportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportExcelButton" Content="Import Excel"
                                        Click="ImportExcelButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportInvoicesButton" Content="Export Excel"
                                        Click="ExportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportCsvButton" Content="Export CSV"
                                        Click="ExportCsvButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadTemplateButton" Content="Excel template"
                                        Click="DownloadTemplateButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="DocumentTypeBox" Width="170" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Payment reminder" Tag="payment_reminder" />
                                    <ComboBoxItem Content="Dunning level 1" Tag="dunning_1" />
                                    <ComboBoxItem Content="Dunning level 2" Tag="dunning_2" />
                                    <ComboBoxItem Content="Dunning level 3" Tag="dunning_3" />
                                </ComboBox>
                                <Button x:Name="GenerateDocumentButton" Content="Generate document"
                                        Click="GenerateDocumentButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingMembersButton" Content="Included invoices"
                                        Click="AccountingMembersButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingRulesButton" Content="Dunning rules"
                                        Click="AccountingRulesButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="AdministrationSectionBox" Width="175" Margin="0,0,8,0"
                                          SelectionChanged="AdministrationSectionBox_OnSelectionChanged">
                                    <ComboBoxItem Content="User roles" Tag="roles" />
                                    <ComboBoxItem Content="Backups" Tag="backups" />
                                    <ComboBoxItem x:Name="AuditSectionItem" Content="Audit log" Tag="audit" />
                                    <ComboBoxItem x:Name="EventsSectionItem" Content="Events" Tag="events" />
                                </ComboBox>
                                <ComboBox x:Name="RoleBox" Width="105" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="viewer" /><ComboBoxItem Content="editor" />
                                    <ComboBoxItem Content="none" />
                                </ComboBox>
                                <Button x:Name="SetRoleButton" Content="Set role"
                                        Click="SetRoleButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="CreateBackupButton" Content="Create backup"
                                        Click="CreateBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadBackupButton" Content="Download backup"
                                        Click="DownloadBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="RestoreBackupButton" Content="Restore"
                                        Click="RestoreBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DeleteBackupButton" Content="Delete backup"
                                        Click="DeleteBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="TestNotificationButton" Content="Test notification"
                                        Click="TestNotificationButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ManualUpdateButton" Content="Check for updates"
                                        Click="ManualUpdateButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="LanguageBox" Width="130" SelectedIndex="0"
                                          SelectionChanged="LanguageBox_OnSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="German" Tag="de" />
                                </ComboBox>
                                <CheckBox x:Name="DeveloperModeBox" Content="Developer mode"
                                          Margin="14,0,0,0" VerticalAlignment="Center"
                                          Foreground="#C8D2E3"
                                          Checked="DeveloperModeBox_OnChanged"
                                          Unchecked="DeveloperModeBox_OnChanged" />
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" MinWidth="420" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.25*" MinWidth="430" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="TaskYearPanel" Grid.ColumnSpan="3" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="13" Padding="26,22" Margin="0,0,0,16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0" />
                                            <GradientStop Color="#1D4ED8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="TaskYearTitleText" Text="Aufgaben 2026" Foreground="White"
                                                       FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TaskYearSummaryText" Text="Aufgaben werden geladen"
                                                       Foreground="#DCE9FF" FontSize="13" Margin="0,7,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="18"
                                                Padding="15,8" VerticalAlignment="Center">
                                            <TextBlock x:Name="TaskYearEffortText" Text="–" Foreground="White"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,11"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="YearTaskStatusFilterBox" Width="160" Margin="0,0,9,0"
                                                      SelectedIndex="0" SelectionChanged="YearTaskFilterBox_OnChanged">
                                                <ComboBoxItem Content="Alle Status" Tag="" />
                                                <ComboBoxItem Content="Offen" Tag="open" />
                                                <ComboBoxItem Content="In Bearbeitung" Tag="in_progress" />
                                                <ComboBoxItem Content="Erledigt" Tag="completed" />
                                                <ComboBoxItem Content="Übersprungen" Tag="skipped" />
                                                <ComboBoxItem Content="Abgebrochen" Tag="cancelled" />
                                            </ComboBox>
                                            <ComboBox x:Name="YearTaskSourceFilterBox" Width="180" SelectedIndex="0"
                                                      SelectionChanged="YearTaskFilterBox_OnChanged">
                                                <ComboBoxItem Content="Alle Aufgabenarten" Tag="" />
                                                <ComboBoxItem Content="Routinen" Tag="routine" />
                                                <ComboBoxItem Content="Manuell" Tag="manual" />
                                                <ComboBoxItem Content="Zahlung &amp; Mahnung" Tag="accounting_due_batch" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock x:Name="TaskSelectionText" Text="Keine Auswahl"
                                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <Button Content="↻" Width="42" Padding="0" ToolTip="Aktualisieren"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RefreshModuleButton_OnClick" Margin="0,0,8,0" />
                                            <Button x:Name="TaskAddButton" Content="+" Width="42" Padding="0"
                                                    FontSize="20" ToolTip="Neue Aufgabe"
                                                    Click="NewTaskButton_OnClick" Margin="0,0,8,0" />
                                            <Button x:Name="TaskEditButton" Content="Bearbeiten" IsEnabled="False"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="TaskEditButton_OnClick" Margin="0,0,8,0" />
                                            <Button x:Name="TaskBulkDeleteButton" Content="Ausgewählte löschen"
                                                    IsEnabled="False" Background="#FEE2E2" Foreground="#B91C1C"
                                                    Click="TaskBulkDeleteButton_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <TextBlock x:Name="TaskYearEmptyText"
                                               Text="Für dieses Kalenderjahr wurden keine Aufgaben gefunden."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#64748B" FontSize="14" Visibility="Collapsed" />
                                    <ListBox x:Name="TaskYearList" Background="Transparent" BorderThickness="0"
                                             SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="TaskYearList_OnSelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                                             Handler="TaskYearItem_OnPreviewMouseLeftButtonDown" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MonthTitle}" FontSize="18"
                                                               FontWeight="SemiBold" Margin="2,18,0,10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMonthStart}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border CornerRadius="11" BorderBrush="#DCE4EF" BorderThickness="1"
                                                            Margin="0,0,0,10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                        <Setter Property="BorderBrush" Value="#60A5FA" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="46" />
                                                                <ColumnDefinition Width="46" />
                                                                <ColumnDefinition Width="128" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      ToolTip="Für Sammelaktion auswählen" />
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                                      IsEnabled="{Binding CanComplete}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      ToolTip="Als erledigt markieren"
                                                                      Click="TaskCompletionCheckBox_OnClick" />
                                                            <StackPanel Grid.Column="2" Margin="4,14,12,14">
                                                                <TextBlock Text="{Binding DayLabel}" FontSize="20"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding WeekdayAndTime}" Foreground="#64748B"
                                                                           FontSize="11" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="{Binding Accent}" />
                                                            <StackPanel Grid.Column="4" Margin="20,14" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Meta}" Foreground="#64748B" FontSize="12"
                                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="12,0,16,0"
                                                                        VerticalAlignment="Center">
                                                                <Border Background="#EFF6FF" CornerRadius="14" Padding="11,6"
                                                                        Margin="0,0,9,0">
                                                                    <TextBlock Text="{Binding Duration}" Foreground="#1D4ED8"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                                <Border Background="#F1F5F9" CornerRadius="14" Padding="11,6">
                                                                    <TextBlock Text="{Binding Status}" Foreground="#475569" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                            <Border x:Name="RecordListCard" Grid.Column="0"
                                    Style="{StaticResource CardStyle}" Padding="0">
                                <DataGrid x:Name="ModuleDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionChanged="ModuleDataGrid_OnSelectionChanged"
                                          HeadersVisibility="Column" CanUserAddRows="False" RowHeight="52"
                                          ColumnHeaderHeight="44" FontSize="14" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Aufgabe" Binding="{Binding Title}" Width="2.2*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.75*" />
                                        <DataGridTextColumn Header="Fällig / Aufwand" Binding="{Binding Detail}" Width="1.35*" />
                                        <DataGridTextColumn x:Name="RevisionColumn" Header="Rev."
                                                            Binding="{Binding Revision}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border x:Name="EditorCard" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="EditorTitleText" Text="Record" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EditorMetaText" Foreground="#718096" FontSize="11" Margin="0,4,0,12" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="RecordEditorText" AcceptsReturn="True" AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />

                                        <TextBlock x:Name="FriendlyDetailsText" Visibility="Collapsed"
                                          Foreground="{StaticResource TextBrush}" FontSize="13"
                                                   TextWrapping="Wrap" LineHeight="23" />

                                        <ScrollViewer x:Name="ContactEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNameBox" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Customer number" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactCustomerNumberBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Phone" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactPhoneBox" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="E-Mail" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactEmailBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Address" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactAddressBox" AcceptsReturn="True" Height="72"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <TextBlock Text="Note" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNoteBox" AcceptsReturn="True" Height="95"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="TopicEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicNameBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Description" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicDescriptionBox" AcceptsReturn="True" Height="65"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Category" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicCategoryBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Priority" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TopicPriorityBox" SelectedIndex="1">
                                                            <ComboBoxItem Content="Low" Tag="low" />
                                                            <ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="High" Tag="high" />
                                                            <ComboBoxItem Content="Critical" Tag="critical" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Minutes" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicMinutesBox" Text="0" />
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="TopicEnabledBox" Content="Topic active"
                                                          IsChecked="True" Margin="0,0,0,12" />
                                                <TextBlock Text="Instructions" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicInstructionsBox" AcceptsReturn="True" Height="80"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock Text="Checklist" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Add item" Padding="10,6"
                                                                Click="AddTopicStepButton_OnClick" Margin="0,0,7,0" />
                                                        <Button Content="Remove" Padding="10,6"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RemoveTopicStepButton_OnClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="TopicStepsGrid" AutoGenerateColumns="False"
                                                          CanUserAddRows="False" MinHeight="180" MaxHeight="260"
                                                          >
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Title *" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                                        <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="65" />
                                                        <DataGridTextColumn Header="min." Binding="{Binding EstimatedMinutes}" Width="55" />
                                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}" Width="55" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="RoutineEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Was soll regelmäßig erledigt werden?" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Aus dieser Routine entsteht automatisch eine Aufgabe."
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
                                                <TextBlock Text="Aufgabe *" Margin="0,0,0,5" />
                                                <TextBox x:Name="RoutineNameBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Kurze Beschreibung (optional)" Margin="0,0,0,5" />
                                                <TextBox x:Name="RoutineDescriptionBox" AcceptsReturn="True" Height="68"
                                                         TextWrapping="Wrap" Margin="0,0,0,14" />
                                                <Grid Margin="0,0,0,18">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Geschätzte Dauer" Margin="0,0,0,5" />
                                                        <DockPanel><TextBox x:Name="RoutineEstimatedMinutesBox" Text="15" MinWidth="90" />
                                                            <TextBlock Text="Minuten" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></DockPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Priorität der Aufgabe" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutinePriorityBox" SelectedIndex="1"
                                                                  SelectionChanged="RoutinePriorityBox_OnSelectionChanged">
                                                            <ComboBoxItem Content="Niedrig" Tag="low" /><ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="Hoch" Tag="high" /><ComboBoxItem Content="Kritisch" Tag="critical" />
                                                        </ComboBox>
                                                        <TextBlock x:Name="RoutinePriorityHintText" Text="Neue Aufgaben erhalten die Priorität Normal."
                                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Wann soll die Aufgabe erscheinen?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                                <TextBlock Text="Wiederholung" Margin="0,0,0,5" />
                                                <ComboBox x:Name="RoutineFrequencyBox" SelectedIndex="3" Margin="0,0,0,12"
                                                          SelectionChanged="RoutineFrequencyBox_OnSelectionChanged">
                                                    <ComboBoxItem Content="Einmalig" Tag="once" />
                                                    <ComboBoxItem Content="Täglich" Tag="daily" />
                                                    <ComboBoxItem Content="Wöchentlich" Tag="weekly" />
                                                    <ComboBoxItem Content="Monatlich" Tag="monthly" />
                                                    <ComboBoxItem Content="Jährlich" Tag="yearly" />
                                                </ComboBox>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="145" /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Beginnt am" Margin="0,0,0,5" />
                                                        <DatePicker x:Name="RoutineStartDatePicker" SelectedDateFormat="Long" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Uhrzeit" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineDueTimeBox" IsEditable="True" Text="09:00">
                                                            <ComboBoxItem Content="08:00" /><ComboBoxItem Content="09:00" />
                                                            <ComboBoxItem Content="10:00" /><ComboBoxItem Content="12:00" />
                                                            <ComboBoxItem Content="14:00" /><ComboBoxItem Content="16:00" />
                                                        </ComboBox></StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="RoutineWeekdayPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                                    <TextBlock Text="An diesen Wochentagen" Margin="0,0,0,7" />
                                                    <WrapPanel>
                                                        <CheckBox x:Name="RoutineMondayBox" Content="Mo" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineTuesdayBox" Content="Di" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineWednesdayBox" Content="Mi" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineThursdayBox" Content="Do" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineFridayBox" Content="Fr" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineSaturdayBox" Content="Sa" Margin="0,0,15,0" />
                                                        <CheckBox x:Name="RoutineSundayBox" Content="So" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="RoutineMonthDayPanel" Margin="0,0,0,12">
                                                    <TextBlock Text="Am Tag des Monats" Margin="0,0,0,5" />
                                                    <ComboBox x:Name="RoutineMonthDaysBox" IsEditable="True" Text="1">
                                                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                                                        <ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="17"/><ComboBoxItem Content="18"/><ComboBoxItem Content="19"/><ComboBoxItem Content="20"/>
                                                        <ComboBoxItem Content="21"/><ComboBoxItem Content="22"/><ComboBoxItem Content="23"/><ComboBoxItem Content="24"/><ComboBoxItem Content="25"/><ComboBoxItem Content="26"/><ComboBoxItem Content="27"/><ComboBoxItem Content="28"/><ComboBoxItem Content="29"/><ComboBoxItem Content="30"/><ComboBoxItem Content="31"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel x:Name="RoutineYearMonthPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                                    <TextBlock Text="Im Monat (1–12)" Margin="0,0,0,5" />
                                                    <ComboBox x:Name="RoutineMonthsBox" IsEditable="True" Text="1">
                                                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                                        <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <Expander Header="Weitere Einstellungen" Margin="0,3,0,14">
                                                    <StackPanel Margin="0,10,0,0">
                                                        <TextBlock Text="Endet am (optional)" Margin="0,0,0,5" />
                                                        <DatePicker x:Name="RoutineEndDatePicker" SelectedDateFormat="Long" Margin="0,0,0,12" />
                                                        <TextBlock Text="Wenn der Termin auf ein Wochenende fällt" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineBusinessDayBox" SelectedIndex="0" Margin="0,0,0,12">
                                                            <ComboBoxItem Content="Nicht verschieben" Tag="none" />
                                                            <ComboBoxItem Content="Auf vorherigen Werktag" Tag="previous_business_day" />
                                                            <ComboBoxItem Content="Auf nächsten Werktag" Tag="next_business_day" />
                                                        </ComboBox>
                                                        <TextBlock Text="Erinnerungen in Tagen, z. B. -1,0" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineRemindersBox" Text="-1,0" />
                                                    </StackPanel>
                                                </Expander>
                                                <CheckBox x:Name="RoutineEnabledBox" Content="Routine ist aktiv"
                                                          IsChecked="True" Margin="0,0,0,8" />

                                                <Grid Visibility="Collapsed">
                                                    <TextBox x:Name="RoutineIntervalBox" Text="1" />
                                                    <TextBox x:Name="RoutineStartDateBox" />
                                                    <TextBox x:Name="RoutineEndDateBox" />
                                                    <TextBox x:Name="RoutineDatesBox" />
                                                    <ComboBox x:Name="RoutineInvalidDayBox" SelectedIndex="1"><ComboBoxItem Tag="skip"/><ComboBoxItem Tag="last_day"/></ComboBox>
                                                    <ComboBox x:Name="RoutineCatchUpBox" SelectedIndex="0"><ComboBoxItem Tag="configured_window"/></ComboBox>
                                                    <TextBox x:Name="RoutineTimezoneBox" Text="Europe/Berlin" />
                                                    <ListBox x:Name="RoutineTopicsList" />
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="TaskEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Title *" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskTitleBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Description" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskDescriptionBox" AcceptsReturn="True" Height="82"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="135" /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Fällig am" Margin="0,0,0,5" />
                                                        <DatePicker x:Name="TaskDueDatePicker" SelectedDateFormat="Long" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Uhrzeit" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TaskDueTimeBox" IsEditable="True" Text="09:00">
                                                            <ComboBoxItem Content="08:00" /><ComboBoxItem Content="09:00" />
                                                            <ComboBoxItem Content="10:00" /><ComboBoxItem Content="12:00" />
                                                            <ComboBoxItem Content="14:00" /><ComboBoxItem Content="16:00" />
                                                            <ComboBoxItem Content="18:00" />
                                                        </ComboBox></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Priority" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TaskPriorityBox" SelectedIndex="1">
                                                            <ComboBoxItem Content="Low" Tag="low" /><ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="High" Tag="high" /><ComboBoxItem Content="Critical" Tag="critical" />
                                                        </ComboBox></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Aufwand (Minuten)" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TaskEstimatedMinutesBox" Text="15" /></StackPanel>
                                                </Grid>
                                                <ComboBox x:Name="TaskEditorStatusBox" SelectedIndex="0" Visibility="Collapsed">
                                                    <ComboBoxItem Content="Open" Tag="open" /><ComboBoxItem Content="In progress" Tag="in_progress" />
                                                    <ComboBoxItem Content="Completed" Tag="completed" /><ComboBoxItem Content="Skipped" Tag="skipped" />
                                                    <ComboBoxItem Content="Cancelled" Tag="cancelled" />
                                                </ComboBox>
                                                <TextBlock Text="Category" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskCategoryBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Completion note" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskCompletionNoteBox" AcceptsReturn="True" Height="60"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock Text="Checklist" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button x:Name="AddTaskChecklistButton" Content="Add item" Padding="10,6"
                                                                Click="AddTaskChecklistButton_OnClick" Margin="0,0,7,0" />
                                                        <Button x:Name="RemoveTaskChecklistButton" Content="Remove" Padding="10,6"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RemoveTaskChecklistButton_OnClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="TaskChecklistGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                          MinHeight="180" MaxHeight="270">
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn Header="Completed" Binding="{Binding Completed}" Width="70" />
                                                        <DataGridCheckBoxColumn x:Name="TaskChecklistRequiredColumn" Header="Required"
                                                                                Binding="{Binding Required}" Width="55" />
                                                        <DataGridTextColumn x:Name="TaskChecklistTitleColumn" Header="Item"
                                                                            Binding="{Binding Title}" Width="1.4*" />
                                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid x:Name="TaskActionPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="TaskStatusBox" Width="165" SelectedIndex="0" Margin="0,0,8,0">
                                                <ComboBoxItem Content="Offen" Tag="open" />
                                                <ComboBoxItem Content="In Bearbeitung" Tag="in_progress" />
                                                <ComboBoxItem Content="Erledigt" Tag="completed" />
                                                <ComboBoxItem Content="Übersprungen" Tag="skipped" />
                                                <ComboBoxItem Content="Abgebrochen" Tag="cancelled" />
                                            </ComboBox>
                                            <Button x:Name="SetTaskStatusButton" Content="Status ändern"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="SetTaskStatusButton_OnClick" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="DeleteTaskButton" Content="Löschen" Margin="0,0,8,0"
                                                    Background="#FEE2E2" Foreground="#B91C1C"
                                                    Click="DeleteTaskButton_OnClick" />
                                            <Button x:Name="TaskSaveButton" Content="Änderungen speichern"
                                                    Click="SaveRecordButton_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="EditorHelpText" Grid.Row="3" Foreground="#718096"
                                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
