<Window x:Class="StructuralOffice.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructuralOffice" Width="920" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0B0E14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="26,28">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="Assets/icon.png" Width="54" Height="54"
                           HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock Text="StructuralOffice" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Windows Client" Foreground="#8894A8" Margin="0,3,0,34" />
                    <Border Background="#1B2433" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="Verbindung" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,10,0,0" Padding="12,10" Opacity="0.5">
                        <StackPanel>
                            <TextBlock Text="Standalone" />
                            <TextBlock Text="später verfügbar" FontSize="11" Foreground="#8894A8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Version 0.2.0-alpha"
                           Foreground="#657086" FontSize="11" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="44,38,48,44" MaxWidth="660" HorizontalAlignment="Left">
                <TextBlock Text="Mit Home Assistant verbinden" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,28" Foreground="#98A4B8" FontSize="14"
                           TextWrapping="Wrap"
                           Text="Melde dich sicher über Home Assistant an. Passwort und Zwei-Faktor-Code werden ausschließlich von Home Assistant verarbeitet." />

                <TextBlock Text="Home-Assistant-Adresse" Margin="0,0,0,7" />
                <TextBox x:Name="ServerUrlBox" Text="http://homeassistant.local:8123"
                         ToolTip="Zum Beispiel http://homeassistant.local:8123" />

                <CheckBox x:Name="RememberLoginBox" Margin="0,18,0,7"
                          Foreground="#E8EDF7" IsChecked="True"
                          Content="Angemeldet bleiben" />
                <TextBlock Margin="24,0,0,22" Foreground="#748097" FontSize="11"
                           TextWrapping="Wrap"
                           Text="Speichert ein Refresh-Token geschützt im Windows-Anmeldeinformationsspeicher. Dein Passwort wird nie gespeichert." />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoginButton" Content="Mit Home Assistant anmelden"
                            Click="LoginButton_OnClick" />
                    <Button x:Name="LogoutButton" Content="Abmelden" Margin="10,0,0,0"
                            Background="#38445A" Visibility="Collapsed"
                            Click="LogoutButton_OnClick" />
                    <TextBlock x:Name="ProgressText" Margin="14,0,0,0"
                               VerticalAlignment="Center" Foreground="#98A4B8" />
                </StackPanel>

                <Border x:Name="ResultPanel" Margin="0,30,0,0" Padding="22"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Verbindungsstatus" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <ItemsControl x:Name="ResultItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                 VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   Foreground="#AAB4C6" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CheckedAtText" Foreground="#657086" FontSize="11"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
