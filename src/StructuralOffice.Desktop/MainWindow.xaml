<Window x:Class="StructuralOffice.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructuralOffice" Icon="Assets/StructuralOffice.ico"
        Width="1120" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B0E14">
    <Grid>
        <!-- First-run and signed-out experience -->
        <Grid x:Name="ConnectionView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="34,36">
                    <StackPanel DockPanel.Dock="Top">
                        <Image Source="Assets/icon.png" Width="62" Height="62"
                               HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <TextBlock Text="StructuralOffice" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Structured office processes at a glance"
                                   Foreground="#8894A8" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Secure sign-in through Home Assistant"
                                   Foreground="#657086" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="Version 0.7.0-alpha" Foreground="#657086"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="68,54" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Connect to Home Assistant" FontSize="31"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,9,0,32" Foreground="#98A4B8" FontSize="14"
                               TextWrapping="Wrap"
                               Text="Sign in securely through Home Assistant. Your password and two-factor code are processed exclusively by Home Assistant." />

                    <Border Style="{StaticResource CardStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Home Assistant address" Margin="0,0,0,8" />
                            <TextBox x:Name="ServerUrlBox" Text="http://homeassistant.local:8123"
                                     ToolTip="For example http://homeassistant.local:8123" />
                            <CheckBox x:Name="RememberLoginBox" Margin="0,20,0,7"
                                      Foreground="#E8EDF7" IsChecked="True"
                                      Content="Stay signed in" />
                            <TextBlock Margin="24,0,0,24" Foreground="#748097" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="The refresh token is protected in Windows Credential Manager. Your password is never stored." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoginButton" Content="Sign in with Home Assistant"
                                        Click="LoginButton_OnClick" />
                                <TextBlock x:Name="ProgressText" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Foreground="#98A4B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultPanel" Margin="0,22,0,0" Padding="22"
                            Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Connection status" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,0,0,14" />
                            <ItemsControl x:Name="ResultItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                     VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       Foreground="#AAB4C6" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CheckedAtText" Foreground="#657086"
                                       FontSize="11" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Authenticated application shell -->
        <Grid x:Name="WorkspaceView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="20,24">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="7,0,0,23">
                            <Image Source="Assets/icon.png" Width="38" Height="38" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StructuralOffice" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="0.7.0-alpha" FontSize="10" Foreground="#657086" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="WORKSPACE" Foreground="#657086" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,0,0,6" />
                        <StackPanel x:Name="NavigationPanel">
                            <Button Content="Overview" Tag="overview" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button x:Name="ContactsNavigationButton" Content="Contacts · Coming soon"
                                    Tag="contacts" Style="{StaticResource NavButtonStyle}" IsEnabled="False" />
                            <Button Content="Topics" Tag="topics" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Routines" Tag="routines" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Tasks" Tag="tasks" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Invoices" Tag="invoices" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button x:Name="DocumentsNavigationButton" Content="Documents · Coming soon"
                                    Tag="documents" Style="{StaticResource NavButtonStyle}" IsEnabled="False" />
                            <Button x:Name="AccountingNavigationButton" Content="Dunning · Coming soon"
                                    Tag="accounting" Style="{StaticResource NavButtonStyle}" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Text="SYSTEM" Foreground="#657086" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,22,0,6" />
                        <Button x:Name="SettingsNavigationButton" Content="Settings" Tag="settings"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavigationButton_OnClick" />
                        <Button x:Name="AdministrationNavigationButton" Content="Administration" Tag="administration"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavigationButton_OnClick" />
                        <Button Content="Standalone  ·  later" IsEnabled="False"
                                Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#171C26" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8"
                                             Fill="#3FC784" Margin="0,0,8,0" />
                                    <TextBlock Text="Connected" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="SidebarServerText" Foreground="#748097"
                                           FontSize="10" Margin="16,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="LogoutButton" Content="Sign out"
                                Style="{StaticResource NavButtonStyle}"
                                Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Background="#0D1119">
                    <Grid Margin="38,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="Overview" FontSize="23"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PageSubtitleText"
                                       Text="Your StructuralOffice workspace"
                                       Foreground="#7F8BA0" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,48">
                            <Border CornerRadius="10" Padding="26" Margin="0,0,0,22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4F9D" Offset="0" />
                                        <GradientStop Color="#17345F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Welcome to StructuralOffice" FontSize="23"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Your central workspace for recurring office processes."
                                                   Foreground="#C6D9F5" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="16"
                                            Padding="13,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DashboardStatusDot" Width="8" Height="8"
                                                     Fill="#6FE1A8" Margin="0,0,8,0" />
                                            <TextBlock x:Name="DashboardStatusText" Text="System ready"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="System status" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,26">
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="CONNECTION" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Online" Foreground="#63D69B" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock x:Name="DashboardServerText" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="INTEGRATION" Foreground="#718096" FontSize="10" />
                                        <TextBlock x:Name="IntegrationVersionText" Text="Ready" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="StructuralOffice backend" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="DATA MODE" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Home Assistant" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="Standalone prepared" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UPDATES" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Automatic" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="GitHub Releases" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Workspaces" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Manage contacts · Coming soon" Tag="contacts"
                                        Margin="0,0,10,10" IsEnabled="False"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Plan routines" Tag="routines" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                                <Button Content="Manage tasks" Tag="tasks" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                                <Button Content="Review invoices" Tag="invoices" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModulePanel" Visibility="Collapsed" Margin="30,24,30,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="RefreshModuleButton" Content="Refresh"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshModuleButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="NewRecordButton" Content="New"
                                            Click="NewRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="SaveRecordButton" Content="Save"
                                            Click="SaveRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="ArchiveRecordButton" Content="Archive"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ArchiveRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="StartEditingButton" Content="Start editing"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="StartEditingButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="ShowEditorsButton" Content="Editors"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ShowEditorsButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="EndEditingButton" Content="End editing"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EndEditingButton_OnClick" />
                                </WrapPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBox x:Name="ModuleSearchBox" Width="190" Padding="9,6"
                                             ToolTip="Search records"
                                             TextChanged="ModuleSearchBox_OnTextChanged" />
                                    <CheckBox x:Name="IncludeArchivedBox" Content="Archived"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Foreground="#C8D2E3"
                                              Checked="IncludeArchivedBox_OnChanged"
                                              Unchecked="IncludeArchivedBox_OnChanged" />
                                </StackPanel>
                                <TextBlock x:Name="ModuleBusyText" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="#91A1B8" />
                            </DockPanel>
                        </Border>

                        <Border x:Name="ContextActionsPanel" Grid.Row="1"
                                Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <WrapPanel>
                                <ComboBox x:Name="TaskStatusFilterBox" Width="145" Margin="0,0,8,0"
                                          SelectionChanged="TaskFilterBox_OnChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All statuses" Tag="" />
                                    <ComboBoxItem Content="Open" Tag="open" />
                                    <ComboBoxItem Content="In progress" Tag="in_progress" />
                                    <ComboBoxItem Content="Completed" Tag="completed" />
                                    <ComboBoxItem Content="Skipped" Tag="skipped" />
                                    <ComboBoxItem Content="Cancelled" Tag="cancelled" />
                                </ComboBox>
                                <ComboBox x:Name="TaskSourceFilterBox" Width="155" Margin="0,0,8,0"
                                          SelectionChanged="TaskFilterBox_OnChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="All sources" Tag="" />
                                    <ComboBoxItem Content="Routines" Tag="routine" />
                                    <ComboBoxItem Content="Manual" Tag="manual" />
                                    <ComboBoxItem Content="Dunning" Tag="accounting_due_batch" />
                                </ComboBox>
                                <Button x:Name="NewTaskButton" Content="Manual task"
                                        Click="NewTaskButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="TaskStatusBox" Width="145" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="open" Tag="open" /><ComboBoxItem Content="in_progress" Tag="in_progress" />
                                    <ComboBoxItem Content="completed" Tag="completed" /><ComboBoxItem Content="skipped" Tag="skipped" />
                                    <ComboBoxItem Content="cancelled" Tag="cancelled" />
                                </ComboBox>
                                <Button x:Name="SetTaskStatusButton" Content="Set task status"
                                        Click="SetTaskStatusButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportInvoicesButton" Content="Import CSV"
                                        Click="ImportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportExcelButton" Content="Import Excel"
                                        Click="ImportExcelButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportInvoicesButton" Content="Export Excel"
                                        Click="ExportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportCsvButton" Content="Export CSV"
                                        Click="ExportCsvButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadTemplateButton" Content="Excel template"
                                        Click="DownloadTemplateButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="DocumentTypeBox" Width="170" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Payment reminder" Tag="payment_reminder" />
                                    <ComboBoxItem Content="Dunning level 1" Tag="dunning_1" />
                                    <ComboBoxItem Content="Dunning level 2" Tag="dunning_2" />
                                    <ComboBoxItem Content="Dunning level 3" Tag="dunning_3" />
                                </ComboBox>
                                <Button x:Name="GenerateDocumentButton" Content="Generate document"
                                        Click="GenerateDocumentButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingMembersButton" Content="Included invoices"
                                        Click="AccountingMembersButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingRulesButton" Content="Dunning rules"
                                        Click="AccountingRulesButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="AdministrationSectionBox" Width="175" Margin="0,0,8,0"
                                          SelectionChanged="AdministrationSectionBox_OnSelectionChanged">
                                    <ComboBoxItem Content="User roles" Tag="roles" />
                                    <ComboBoxItem Content="Backups" Tag="backups" />
                                    <ComboBoxItem Content="Audit log" Tag="audit" />
                                    <ComboBoxItem Content="Events" Tag="events" />
                                </ComboBox>
                                <ComboBox x:Name="RoleBox" Width="105" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="viewer" /><ComboBoxItem Content="editor" />
                                    <ComboBoxItem Content="none" />
                                </ComboBox>
                                <Button x:Name="SetRoleButton" Content="Set role"
                                        Click="SetRoleButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="CreateBackupButton" Content="Create backup"
                                        Click="CreateBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadBackupButton" Content="Download backup"
                                        Click="DownloadBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="RestoreBackupButton" Content="Restore"
                                        Click="RestoreBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DeleteBackupButton" Content="Delete backup"
                                        Click="DeleteBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="TestNotificationButton" Content="Test notification"
                                        Click="TestNotificationButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ManualUpdateButton" Content="Check for updates"
                                        Click="ManualUpdateButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="LanguageBox" Width="130" SelectedIndex="0"
                                          SelectionChanged="LanguageBox_OnSelectionChanged">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="German" Tag="de" />
                                </ComboBox>
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="330" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="0.95*" MinWidth="320" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                                <DataGrid x:Name="ModuleDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Extended" SelectionChanged="ModuleDataGrid_OnSelectionChanged"
                                          Background="#111620" Foreground="#E8EDF7" BorderThickness="0"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B3342"
                                          RowBackground="#111620" AlternatingRowBackground="#151B26"
                                          HeadersVisibility="Column" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.5*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.4*" />
                                        <DataGridTextColumn Header="Rev." Binding="{Binding Revision}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="EditorTitleText" Text="Record" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EditorMetaText" Foreground="#718096" FontSize="11" Margin="0,4,0,12" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="RecordEditorText" AcceptsReturn="True" AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />

                                        <ScrollViewer x:Name="ContactEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNameBox" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Customer number" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactCustomerNumberBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Phone" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactPhoneBox" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="E-Mail" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactEmailBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Address" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactAddressBox" AcceptsReturn="True" Height="72"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <TextBlock Text="Note" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNoteBox" AcceptsReturn="True" Height="95"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="TopicEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicNameBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Description" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicDescriptionBox" AcceptsReturn="True" Height="65"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Category" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicCategoryBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Priority" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TopicPriorityBox" SelectedIndex="1">
                                                            <ComboBoxItem Content="Low" Tag="low" />
                                                            <ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="High" Tag="high" />
                                                            <ComboBoxItem Content="Critical" Tag="critical" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Minutes" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicMinutesBox" Text="0" />
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="TopicEnabledBox" Content="Topic active"
                                                          Foreground="#E8EDF7" IsChecked="True" Margin="0,0,0,12" />
                                                <TextBlock Text="Instructions" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicInstructionsBox" AcceptsReturn="True" Height="80"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock Text="Checklist" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Add item" Padding="10,6"
                                                                Click="AddTopicStepButton_OnClick" Margin="0,0,7,0" />
                                                        <Button Content="Remove" Padding="10,6"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RemoveTopicStepButton_OnClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="TopicStepsGrid" AutoGenerateColumns="False"
                                                          CanUserAddRows="False" MinHeight="180" MaxHeight="260"
                                                          Background="#111620" Foreground="#E8EDF7"
                                                          RowBackground="#111620" AlternatingRowBackground="#151B26"
                                                          HorizontalGridLinesBrush="#2B3342" VerticalGridLinesBrush="#2B3342">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Title *" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                                        <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="65" />
                                                        <DataGridTextColumn Header="min." Binding="{Binding EstimatedMinutes}" Width="55" />
                                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}" Width="55" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="RoutineEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="RoutineNameBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Description" Margin="0,0,0,5" />
                                                <TextBox x:Name="RoutineDescriptionBox" AcceptsReturn="True" Height="60"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <CheckBox x:Name="RoutineEnabledBox" Content="Routine active"
                                                          IsChecked="True" Foreground="#E8EDF7" Margin="0,0,0,12" />
                                                <TextBlock Text="Assigned topics *" Margin="0,0,0,5" />
                                                <ListBox x:Name="RoutineTopicsList" Height="105"
                                                         Background="#111620" BorderBrush="#39445A" Margin="0,0,0,12">
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                                  Foreground="#E8EDF7" Margin="7,4" />
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Recurrence" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineFrequencyBox" SelectedIndex="3">
                                                            <ComboBoxItem Content="Once" Tag="once" />
                                                            <ComboBoxItem Content="Daily" Tag="daily" />
                                                            <ComboBoxItem Content="Weekly" Tag="weekly" />
                                                            <ComboBoxItem Content="Monthly" Tag="monthly" />
                                                            <ComboBoxItem Content="Yearly" Tag="yearly" />
                                                        </ComboBox></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Interval" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineIntervalBox" Text="1" /></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" />
                                                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Start date" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineStartDateBox" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="End date" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineEndDateBox" /></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="Due at" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineDueTimeBox" Text="09:00" /></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Weekdays (for weekly)" Margin="0,0,0,5" />
                                                <WrapPanel Margin="0,0,0,12">
                                                    <CheckBox x:Name="RoutineMondayBox" Content="Mo" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineTuesdayBox" Content="Di" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineWednesdayBox" Content="Mi" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineThursdayBox" Content="Do" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineFridayBox" Content="Fr" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineSaturdayBox" Content="Sa" Foreground="#E8EDF7" Margin="0,0,12,0" />
                                                    <CheckBox x:Name="RoutineSundayBox" Content="So" Foreground="#E8EDF7" />
                                                </WrapPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Month days (for example 1,15)" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineMonthDaysBox" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Months (1–12)" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineMonthsBox" /></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Explicit dates (YYYY-MM-DD, comma-separated)" Margin="0,0,0,5" />
                                                <TextBox x:Name="RoutineDatesBox" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Weekend rule" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineBusinessDayBox" SelectedIndex="0">
                                                            <ComboBoxItem Content="None" Tag="none" />
                                                            <ComboBoxItem Content="Previous business day" Tag="previous_business_day" />
                                                            <ComboBoxItem Content="Next business day" Tag="next_business_day" />
                                                        </ComboBox></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Invalid month day" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineInvalidDayBox" SelectedIndex="0">
                                                            <ComboBoxItem Content="Skip" Tag="skip" />
                                                            <ComboBoxItem Content="Last day of month" Tag="last_day" />
                                                        </ComboBox></StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Reminder days (-1,0)" Margin="0,0,0,5" />
                                                        <TextBox x:Name="RoutineRemindersBox" Text="-1,0" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Catch-up rule" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="RoutineCatchUpBox" SelectedIndex="0">
                                                            <ComboBoxItem Content="Configured window" Tag="configured_window" />
                                                            <ComboBoxItem Content="Only latest occurrence" Tag="latest_only" />
                                                            <ComboBoxItem Content="Skip missed" Tag="skip_missed" />
                                                        </ComboBox></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Time zone" Margin="0,12,0,5" />
                                                <TextBox x:Name="RoutineTimezoneBox" Text="Europe/Berlin" />
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="TaskEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Title *" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskTitleBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Description" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskDescriptionBox" AcceptsReturn="True" Height="60"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" />
                                                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Due date" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TaskDueAtBox" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Priority" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TaskPriorityBox" SelectedIndex="1">
                                                            <ComboBoxItem Content="Low" Tag="low" /><ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="High" Tag="high" /><ComboBoxItem Content="Critical" Tag="critical" />
                                                        </ComboBox></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="Status" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TaskEditorStatusBox" SelectedIndex="0">
                                                            <ComboBoxItem Content="Open" Tag="open" /><ComboBoxItem Content="In progress" Tag="in_progress" />
                                                            <ComboBoxItem Content="Completed" Tag="completed" /><ComboBoxItem Content="Skipped" Tag="skipped" />
                                                            <ComboBoxItem Content="Cancelled" Tag="cancelled" />
                                                        </ComboBox></StackPanel>
                                                </Grid>
                                                <TextBlock Text="Category" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskCategoryBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Completion note" Margin="0,0,0,5" />
                                                <TextBox x:Name="TaskCompletionNoteBox" AcceptsReturn="True" Height="60"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock Text="Checklist" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button x:Name="AddTaskChecklistButton" Content="Add item" Padding="10,6"
                                                                Click="AddTaskChecklistButton_OnClick" Margin="0,0,7,0" />
                                                        <Button x:Name="RemoveTaskChecklistButton" Content="Remove" Padding="10,6"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RemoveTaskChecklistButton_OnClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="TaskChecklistGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                          MinHeight="180" MaxHeight="270" Background="#111620" Foreground="#E8EDF7"
                                                          RowBackground="#111620" AlternatingRowBackground="#151B26">
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn Header="Completed" Binding="{Binding Completed}" Width="70" />
                                                        <DataGridCheckBoxColumn x:Name="TaskChecklistRequiredColumn" Header="Required"
                                                                                Binding="{Binding Required}" Width="55" />
                                                        <DataGridTextColumn x:Name="TaskChecklistTitleColumn" Header="Item"
                                                                            Binding="{Binding Title}" Width="1.4*" />
                                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                    <TextBlock x:Name="EditorHelpText" Grid.Row="2" Foreground="#718096"
                                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
