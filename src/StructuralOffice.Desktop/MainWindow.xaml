<Window x:Class="StructuralOffice.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructuralOffice" Icon="Assets/StructuralOffice.ico"
        Width="1120" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B0E14">
    <Grid>
        <!-- First-run and signed-out experience -->
        <Grid x:Name="ConnectionView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="34,36">
                    <StackPanel DockPanel.Dock="Top">
                        <Image Source="Assets/icon.png" Width="62" Height="62"
                               HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <TextBlock Text="StructuralOffice" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Büroprozesse strukturiert im Blick"
                                   Foreground="#8894A8" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Sichere Anmeldung über Home Assistant"
                                   Foreground="#657086" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="Version 0.5.0-alpha" Foreground="#657086"
                                   FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="68,54" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Mit Home Assistant verbinden" FontSize="31"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,9,0,32" Foreground="#98A4B8" FontSize="14"
                               TextWrapping="Wrap"
                               Text="Melde dich sicher über Home Assistant an. Passwort und Zwei-Faktor-Code werden ausschließlich von Home Assistant verarbeitet." />

                    <Border Style="{StaticResource CardStyle}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Home-Assistant-Adresse" Margin="0,0,0,8" />
                            <TextBox x:Name="ServerUrlBox" Text="http://homeassistant.local:8123"
                                     ToolTip="Zum Beispiel http://homeassistant.local:8123" />
                            <CheckBox x:Name="RememberLoginBox" Margin="0,20,0,7"
                                      Foreground="#E8EDF7" IsChecked="True"
                                      Content="Angemeldet bleiben" />
                            <TextBlock Margin="24,0,0,24" Foreground="#748097" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Das Refresh-Token wird geschützt im Windows-Anmeldeinformationsspeicher abgelegt. Dein Passwort wird nie gespeichert." />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoginButton" Content="Mit Home Assistant anmelden"
                                        Click="LoginButton_OnClick" />
                                <TextBlock x:Name="ProgressText" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Foreground="#98A4B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultPanel" Margin="0,22,0,0" Padding="22"
                            Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Verbindungsstatus" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,0,0,14" />
                            <ItemsControl x:Name="ResultItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                     VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                       Foreground="#AAB4C6" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CheckedAtText" Foreground="#657086"
                                       FontSize="11" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Authenticated application shell -->
        <Grid x:Name="WorkspaceView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111620" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="20,24">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="7,0,0,23">
                            <Image Source="Assets/icon.png" Width="38" Height="38" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StructuralOffice" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="0.5.0-alpha" FontSize="10" Foreground="#657086" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="ARBEITSBEREICH" Foreground="#657086" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,0,0,6" />
                        <StackPanel x:Name="NavigationPanel">
                            <Button Content="Übersicht" Tag="overview" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Kontakte" Tag="contacts" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Themen" Tag="topics" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Routinen" Tag="routines" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Aufgaben" Tag="tasks" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Rechnungen" Tag="invoices" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Dokumente" Tag="documents" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                            <Button Content="Mahnwesen" Tag="accounting" Style="{StaticResource NavButtonStyle}"
                                    Click="NavigationButton_OnClick" />
                        </StackPanel>

                        <TextBlock Text="SYSTEM" Foreground="#657086" FontSize="10"
                                   FontWeight="SemiBold" Margin="12,22,0,6" />
                        <Button x:Name="SettingsNavigationButton" Content="Einstellungen" Tag="settings"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavigationButton_OnClick" />
                        <Button x:Name="AdministrationNavigationButton" Content="Administration" Tag="administration"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavigationButton_OnClick" />
                        <Button Content="Standalone  ·  später" IsEnabled="False"
                                Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#171C26" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8"
                                             Fill="#3FC784" Margin="0,0,8,0" />
                                    <TextBlock Text="Verbunden" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="SidebarServerText" Foreground="#748097"
                                           FontSize="10" Margin="16,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="LogoutButton" Content="Abmelden"
                                Style="{StaticResource NavButtonStyle}"
                                Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Background="#0D1119">
                    <Grid Margin="38,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="Übersicht" FontSize="23"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PageSubtitleText"
                                       Text="Dein StructuralOffice-Arbeitsbereich"
                                       Foreground="#7F8BA0" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,48">
                            <Border CornerRadius="10" Padding="26" Margin="0,0,0,22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1D4F9D" Offset="0" />
                                        <GradientStop Color="#17345F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Willkommen bei StructuralOffice" FontSize="23"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Deine zentrale Arbeitsoberfläche für wiederkehrende Büroprozesse."
                                                   Foreground="#C6D9F5" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="16"
                                            Padding="13,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DashboardStatusDot" Width="8" Height="8"
                                                     Fill="#6FE1A8" Margin="0,0,8,0" />
                                            <TextBlock x:Name="DashboardStatusText" Text="System bereit"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Systemstatus" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,26">
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="VERBINDUNG" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Online" Foreground="#63D69B" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock x:Name="DashboardServerText" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="INTEGRATION" Foreground="#718096" FontSize="10" />
                                        <TextBlock x:Name="IntegrationVersionText" Text="Bereit" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="StructuralOffice Backend" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="DATENMODUS" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Home Assistant" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="Standalone vorbereitet" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Width="205" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UPDATES" Foreground="#718096" FontSize="10" />
                                        <TextBlock Text="Automatisch" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                                        <TextBlock Text="GitHub Releases" Foreground="#748097"
                                                   FontSize="10" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="Arbeitsbereiche" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Kontakte verwalten" Tag="contacts" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                                <Button Content="Routinen planen" Tag="routines" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                                <Button Content="Aufgaben bearbeiten" Tag="tasks" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                                <Button Content="Rechnungen prüfen" Tag="invoices" Margin="0,0,10,10"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="NavigationButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModulePanel" Visibility="Collapsed" Margin="30,24,30,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="RefreshModuleButton" Content="Aktualisieren"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RefreshModuleButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="NewRecordButton" Content="Neu"
                                            Click="NewRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="SaveRecordButton" Content="Speichern"
                                            Click="SaveRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="ArchiveRecordButton" Content="Archivieren"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ArchiveRecordButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="StartEditingButton" Content="Bearbeitung starten"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="StartEditingButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="ShowEditorsButton" Content="Bearbeiter"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ShowEditorsButton_OnClick" Margin="0,0,8,0" />
                                    <Button x:Name="EndEditingButton" Content="Bearbeitung beenden"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EndEditingButton_OnClick" />
                                </WrapPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBox x:Name="ModuleSearchBox" Width="190" Padding="9,6"
                                             ToolTip="Datensätze durchsuchen"
                                             TextChanged="ModuleSearchBox_OnTextChanged" />
                                    <CheckBox x:Name="IncludeArchivedBox" Content="Archivierte"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              Foreground="#C8D2E3"
                                              Checked="IncludeArchivedBox_OnChanged"
                                              Unchecked="IncludeArchivedBox_OnChanged" />
                                </StackPanel>
                                <TextBlock x:Name="ModuleBusyText" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="#91A1B8" />
                            </DockPanel>
                        </Border>

                        <Border x:Name="ContextActionsPanel" Grid.Row="1"
                                Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <WrapPanel>
                                <ComboBox x:Name="TaskStatusBox" Width="145" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="open" /><ComboBoxItem Content="in_progress" />
                                    <ComboBoxItem Content="completed" /><ComboBoxItem Content="skipped" />
                                    <ComboBoxItem Content="cancelled" />
                                </ComboBox>
                                <Button x:Name="SetTaskStatusButton" Content="Aufgabenstatus setzen"
                                        Click="SetTaskStatusButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportInvoicesButton" Content="CSV importieren"
                                        Click="ImportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ImportExcelButton" Content="Excel importieren"
                                        Click="ImportExcelButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportInvoicesButton" Content="Excel exportieren"
                                        Click="ExportInvoicesButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="ExportCsvButton" Content="CSV exportieren"
                                        Click="ExportCsvButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadTemplateButton" Content="Excel-Vorlage"
                                        Click="DownloadTemplateButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="DocumentTypeBox" Width="170" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Zahlungserinnerung" Tag="payment_reminder" />
                                    <ComboBoxItem Content="Mahnung Stufe 1" Tag="dunning_1" />
                                    <ComboBoxItem Content="Mahnung Stufe 2" Tag="dunning_2" />
                                    <ComboBoxItem Content="Mahnung Stufe 3" Tag="dunning_3" />
                                </ComboBox>
                                <Button x:Name="GenerateDocumentButton" Content="Dokument erzeugen"
                                        Click="GenerateDocumentButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingMembersButton" Content="Enthaltene Rechnungen"
                                        Click="AccountingMembersButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="AccountingRulesButton" Content="Mahnregeln"
                                        Click="AccountingRulesButton_OnClick" Margin="0,0,8,0" />
                                <ComboBox x:Name="AdministrationSectionBox" Width="175" Margin="0,0,8,0"
                                          SelectionChanged="AdministrationSectionBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Benutzerrollen" Tag="roles" />
                                    <ComboBoxItem Content="Backups" Tag="backups" />
                                    <ComboBoxItem Content="Änderungsprotokoll" Tag="audit" />
                                    <ComboBoxItem Content="Ereignisse" Tag="events" />
                                </ComboBox>
                                <ComboBox x:Name="RoleBox" Width="105" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="viewer" /><ComboBoxItem Content="editor" />
                                    <ComboBoxItem Content="none" />
                                </ComboBox>
                                <Button x:Name="SetRoleButton" Content="Rolle setzen"
                                        Click="SetRoleButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="CreateBackupButton" Content="Backup erstellen"
                                        Click="CreateBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DownloadBackupButton" Content="Backup laden"
                                        Click="DownloadBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="RestoreBackupButton" Content="Wiederherstellen"
                                        Click="RestoreBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="DeleteBackupButton" Content="Backup löschen"
                                        Click="DeleteBackupButton_OnClick" Margin="0,0,8,0" />
                                <Button x:Name="TestNotificationButton" Content="Testbenachrichtigung"
                                        Click="TestNotificationButton_OnClick" />
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="330" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="0.95*" MinWidth="320" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                                <DataGrid x:Name="ModuleDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Extended" SelectionChanged="ModuleDataGrid_OnSelectionChanged"
                                          Background="#111620" Foreground="#E8EDF7" BorderThickness="0"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B3342"
                                          RowBackground="#111620" AlternatingRowBackground="#151B26"
                                          HeadersVisibility="Column" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="1.5*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.4*" />
                                        <DataGridTextColumn Header="Rev." Binding="{Binding Revision}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="EditorTitleText" Text="Datensatz" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="EditorMetaText" Foreground="#718096" FontSize="11" Margin="0,4,0,12" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="RecordEditorText" AcceptsReturn="True" AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />

                                        <ScrollViewer x:Name="ContactEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNameBox" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Kundennummer" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactCustomerNumberBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Telefon" Margin="0,0,0,5" />
                                                        <TextBox x:Name="ContactPhoneBox" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="E-Mail" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactEmailBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Adresse" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactAddressBox" AcceptsReturn="True" Height="72"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <TextBlock Text="Notiz" Margin="0,0,0,5" />
                                                <TextBox x:Name="ContactNoteBox" AcceptsReturn="True" Height="95"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="TopicEditorPanel" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="1">
                                                <TextBlock Text="Name *" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicNameBox" Margin="0,0,0,12" />
                                                <TextBlock Text="Beschreibung" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicDescriptionBox" AcceptsReturn="True" Height="65"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /><ColumnDefinition Width="10" />
                                                        <ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Kategorie" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicCategoryBox" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Priorität" Margin="0,0,0,5" />
                                                        <ComboBox x:Name="TopicPriorityBox" SelectedIndex="1">
                                                            <ComboBoxItem Content="Niedrig" Tag="low" />
                                                            <ComboBoxItem Content="Normal" Tag="normal" />
                                                            <ComboBoxItem Content="Hoch" Tag="high" />
                                                            <ComboBoxItem Content="Kritisch" Tag="critical" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Minuten" Margin="0,0,0,5" />
                                                        <TextBox x:Name="TopicMinutesBox" Text="0" />
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="TopicEnabledBox" Content="Thema aktiv"
                                                          Foreground="#E8EDF7" IsChecked="True" Margin="0,0,0,12" />
                                                <TextBlock Text="Arbeitsanleitung" Margin="0,0,0,5" />
                                                <TextBox x:Name="TopicInstructionsBox" AcceptsReturn="True" Height="80"
                                                         TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <DockPanel Margin="0,0,0,7">
                                                    <TextBlock Text="Checkliste" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Punkt hinzufügen" Padding="10,6"
                                                                Click="AddTopicStepButton_OnClick" Margin="0,0,7,0" />
                                                        <Button Content="Entfernen" Padding="10,6"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="RemoveTopicStepButton_OnClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="TopicStepsGrid" AutoGenerateColumns="False"
                                                          CanUserAddRows="False" MinHeight="180" MaxHeight="260"
                                                          Background="#111620" Foreground="#E8EDF7"
                                                          RowBackground="#111620" AlternatingRowBackground="#151B26"
                                                          HorizontalGridLinesBrush="#2B3342" VerticalGridLinesBrush="#2B3342">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Titel *" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                                        <DataGridCheckBoxColumn Header="Pflicht" Binding="{Binding Required}" Width="65" />
                                                        <DataGridTextColumn Header="Min." Binding="{Binding EstimatedMinutes}" Width="55" />
                                                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="55" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                    <TextBlock x:Name="EditorHelpText" Grid.Row="2" Foreground="#718096"
                                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
